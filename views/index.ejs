<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Country Catalog</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg bg-dark navbar-dark shadow-sm">
        <div class="container-fluid gap-2">
            <span class="navbar-brand fw-bold">World Country Catalog</span>
            <% if (loggedIn) { %>
                <a class="btn btn-outline-light" href="/logout">Logout</a>
            <% } else { %>
                <form class="d-flex flex-column flex-sm-row gap-2" action="/login" method="post">
                    <input class="form-control" type="text" id="username" name="username" placeholder="Username" aria-label="Username" autocomplete="username" required>
                    <input class="form-control" type="password" id="password" name="password" placeholder="Password" aria-label="Password" autocomplete="current-password" required>
                    <button class="btn btn-primary text-nowrap" type="submit">Sign In</button>
                </form>
            <% } %>
        </div>
    </nav>

    <div class="container mt-5">
        <div class="row align-items-center g-4 bg-white p-4 rounded shadow-sm">
            <div class="col-md-6">
                <h1 class="display-6 fw-bold">Country Catalog Website Project</h1>
                <p class="lead text-secondary">
                    Keep track of countries around the globe, their capitals, famous landmarks, populations, and whether you have visited them.
                </p>
                <% if (loggedIn) { %>
                    <div class="mt-4">
                        <a class="btn btn-primary btn-lg" href="/countries">Maintain Records</a>
                    </div>
                <% } else { %>
                    <div class="alert alert-info mt-3 mb-0">
                        Please sign in using the form in the top navigation bar to view and maintain country records.
                    </div>
                <% } %>
            </div>
            <div class="col-md-6 text-center">
                <!-- Relevant world map / globe hero illustration -->
                <img src="/images/hero.jpg"
                     alt="Snow Capped Mountain Range"
                     class="img-fluid rounded border p-2 bg-light">
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
