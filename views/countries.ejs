<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Country Records</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar bg-dark navbar-dark">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="/">World Country Catalog</a>
            <div class="d-flex gap-2">
                <a class="btn btn-outline-light btn-sm" href="/">Home</a>
                <a class="btn btn-danger btn-sm" href="/logout">Logout</a>
            </div>
        </div>
    </nav>

    <div class="container mt-4 mb-5">
        <h1 class="mb-3">Saved Countries</h1>

        <div class="table-responsive bg-white rounded shadow-sm">
            <table class="table table-striped table-bordered align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Country Name</th>
                        <th>Popular Site</th>
                        <th>Capital</th>
                        <th>Population</th>
                        <th>Visited</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% countries.forEach(country => { %>
                    <tr>
                        <td><%= country.country_id %></td>
                        <td class="fw-semibold"><%= country.country_name %></td>
                        <td><%= country.popular_site %></td>
                        <td><%= country.capital %></td>
                        <td><%= Number(country.population).toLocaleString() %></td>
                        <td><%= country.visited ? country.visited : "" %></td>
                        <td class="text-nowrap">
                            <a class="btn btn-sm btn-primary" href="/editCountry/<%= country.country_id %>">Edit</a>
                            <form action="/deleteCountry/<%= country.country_id %>" method="POST" class="d-inline"
                                  data-country-name="<%= country.country_name %>"
                                  onsubmit="return confirm('Are you sure you want to delete ' + this.dataset.countryName + '?');">
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                            <button type="button" class="btn btn-sm btn-info text-white"
                                    data-country-name="<%= country.country_name %>"
                                    data-capital="<%= country.capital %>"
                                    data-site="<%= country.popular_site %>"
                                    onclick="showMap(this.dataset.countryName, this.dataset.capital, this.dataset.site)">
                                Map
                            </button>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <!-- Requirement 4: Add button at the bottom of the page -->
        <div class="mt-3 d-flex gap-2">
            <a class="btn btn-success" href="/addCountry">Add Country</a>
            <a class="btn btn-secondary" href="/">Back to Home</a>
        </div>

        <!-- Requirement 6: On-page map container -->
        <div id="mapSection" class="card mt-4 shadow-sm d-none">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <span id="mapTitle" class="fw-bold">Country Map</span>
                <button type="button" class="btn btn-sm btn-outline-light" onclick="closeMap()">Close Map</button>
            </div>
            <div class="card-body p-0">
                <iframe title="Selected country map" id="mapFrame" width="100%" height="420" style="border:0;" loading="lazy" allowfullscreen></iframe>
            </div>
        </div>
    </div>

    <script src="/js/countries.js"></script>
</body>
</html>