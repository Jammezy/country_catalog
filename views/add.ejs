<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Country</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-4" style="max-width: 640px;">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-3">Add Country</h1>
                <!-- Notice country_id is NOT asked for; PostgreSQL generates it automatically -->
                <form action="/addCountry" method="POST">
                    <div class="mb-3">
                        <label for="country_name" class="form-label">Country Name (max 30 chars)</label>
                        <input type="text" class="form-control" id="country_name" name="country_name" maxlength="30" required>
                    </div>
                    <div class="mb-3">
                        <label for="popular_site" class="form-label">Popular Site (max 50 chars)</label>
                        <input type="text" class="form-control" id="popular_site" name="popular_site" maxlength="50" required>
                    </div>
                    <div class="mb-3">
                        <label for="capital" class="form-label">Capital (max 30 chars)</label>
                        <input type="text" class="form-control" id="capital" name="capital" maxlength="30" required>
                    </div>
                    <div class="mb-3">
                        <label for="population" class="form-label">Population (whole number &ge; 0)</label>
                        <input type="number" class="form-control" id="population" name="population" min="0" max="2147483647" step="1" required>
                    </div>
                    <div class="mb-3">
                        <label for="visited" class="form-label">Visited? (Optional)</label>
                        <select class="form-select" id="visited" name="visited">
                            <option value="">-- Not Specified (NULL) --</option>
                            <option value="Y">Y (Yes)</option>
                            <option value="N">N (No)</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-success">Add Country</button>
                    <a class="btn btn-secondary" href="/countries">Back to Countries</a>
                </form>
            </div>
        </div>
    </div>


</body>
</html>